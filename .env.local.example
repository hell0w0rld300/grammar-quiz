# ─────────────────────────────────────────────────────────────────
# 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL 数据库（必需，来自 Vercel Postgres 或 Neon）──────
# 在 Vercel 项目中添加 Postgres 数据库后，这些变量会自动注入
POSTGRES_URL="postgres://username:password@hostname:5432/dbname?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://username:password@hostname:5432/dbname?sslmode=require"

# ── 管理后台配置（强烈建议修改默认值）────────────────────────────
# 管理员登录密码（默认：admin123）
ADMIN_PASSWORD="your-strong-password-here"

# 签名密钥，用于 admin cookie 的安全验证（随机字符串即可）
ADMIN_SECRET="your-random-secret-key-32-chars-min"
